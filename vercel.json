{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "my_frontend": {
      "root": "frontend/"
    },
    "my_backend": {
      "root": "backend/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "my_backend"
      }
    },
    {
      "source": "/static/(.*)",
      "destination": {
        "service": "my_backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "my_frontend"
      }
    }
  ]
}
